# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret Key (Generate a long random string in production)
JWT_SECRET=replace_with_a_long_random_entropy_secret_key_32chars!

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://bloggy_user:your_secure_password@localhost:5432/bloggy_production

# Client origin for CORS
CLIENT_ORIGIN=http://your-domain-or-ip.com
