# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=super_secret_bloggy_jwt_key_change_in_production_2025!

# PostgreSQL Database Configuration
# You can use a full connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloggy_db
# Or discrete parameters:
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=bloggy_db

# Client origin for CORS (when running behind separate dev port or proxy)
CLIENT_ORIGIN=http://localhost:5173
